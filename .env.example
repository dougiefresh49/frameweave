# Copy to .env at the repo root (gitignored). Precedence: CLI flag > FRAMEWEAVE_* env > ~/.config/frameweave/config.toml > default.
# Every Config field has an env name below (docs/config.md has the full table). Leave a line empty or delete it to keep the default.

# Output root. No default: doctor fails and run exits 1 until this is set. Runs land at <root>/<channel-slug>/<video-slug>/.
FRAMEWEAVE_OUT=~/Desktop/frameweave
# Source and run cache root.
FRAMEWEAVE_CACHE_DIR=~/Library/Caches/frameweave

# Vision. Lane: auto (the chooser picks by quota headroom), claude, gemini, codex (under-transcribes; explicit only), none.
FRAMEWEAVE_VISION_LANE=auto
FRAMEWEAVE_VISION_MODEL_CLAUDE=sonnet
FRAMEWEAVE_VISION_MODEL_GEMINI=gemini-3.5-flash-lite
FRAMEWEAVE_VISION_MODEL_CODEX=gpt-5.6-sol
FRAMEWEAVE_VISION_QUALITY=standard
FRAMEWEAVE_FRAMES_PER_CALL=8
# Vision lane chooser: a lane projected past this percent of either usage window is skipped (decision 40).
FRAMEWEAVE_LANE_SKIP_PERCENT=90
# Vision prompt revision; part of the run key.
FRAMEWEAVE_PROMPT_REVISION=1

# Frames. max_frames empty means the duration rule max(80, 2 * minutes) applies.
FRAMEWEAVE_FRAME_INTERVAL_S=45
FRAMEWEAVE_FRAME_WIDTH=1280
FRAMEWEAVE_MAX_FRAMES=

# Speech. Backend local (WhisperX) or none; device cpu.
FRAMEWEAVE_STT_BACKEND=local
FRAMEWEAVE_STT_MODEL=large-v3-turbo
FRAMEWEAVE_STT_DEVICE=cpu
# Speaker labels (decision 36): off for single-speaker videos, on for meetings.
FRAMEWEAVE_SPEAKERS=false
# Hugging Face read token for pyannote speaker labels. Leave empty to keep diarization off.
HF_TOKEN=

# Calls and limits.
FRAMEWEAVE_TIMEOUT_S=120
FRAMEWEAVE_CONCURRENCY=2
# Warn before a run and in doctor when free disk is under this many GB (decision 35).
FRAMEWEAVE_DISK_WARN_GB=10

# Optional glossary file (caption corrections with reasons; see docs/format.md and the README generator).
FRAMEWEAVE_GLOSSARY=
# Channel display name to folder slug overrides, as JSON. Example: {"Some Channel Name": "some-channel"}
FRAMEWEAVE_CHANNELS=

# Metered vision fallback, used only when the subscription lane is out of headroom or --vision gemini is passed.
GEMINI_API_KEY=

# Not Config fields. Term list for scripts/scrub.sh; lives outside the repo on purpose and is never committed.
FRAMEWEAVE_SCRUB_TERMS=~/.config/frameweave/scrub-terms.txt
# Fixture source: Doug's kickoff recording folder (decision 45). Read-only, never in git.
FRAMEWEAVE_KICKOFF_DIR=
